{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Rodar Haskell",
            "type": "shell",
            "command": "ghc",
            "args": [
                "-dynamic",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$ghc"
        },
        {
            "label": "Executar Haskell",
            "type": "shell",
            "command": "${fileDirname}/${fileBasenameNoExtension}",
            "options": {
                "cwd": "${fileDirname}"
            },
            "dependsOn": "Rodar Haskell",
            "problemMatcher": []
        }
    ]
}